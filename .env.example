# Stripe. Use the test key (sk_test_...) until launch.
# Lives in Cascarelli's own Stripe account, so payouts go straight to them.
STRIPE_SECRET_KEY=sk_test_replace_me

# ── Enquiry mail ─────────────────────────────────────────────────────────────────
# src/app/api/inquiry/route.ts reads all three, and none of them was in this file, which is
# how a form ships to production sending nowhere.
#
# NOTE, and it needs deciding before launch: this route uses Resend, a paid service. The
# house rule is plain SMTP through a mailbox the client already owns (nodemailer), which is
# what MI Gas does — see references/stack.md in the glazed-web skill. Swapping it is a small
# job and removes a bill Cascarelli's did not choose.
RESEND_API_KEY=
# The address the notification is sent FROM. Must be on a domain verified in Resend.
INQUIRY_FROM=
# Where enquiries land. Confirm with Cascarelli's that a human reads it.
INQUIRY_TO=

# Absolute origin, used for share images, structured data, and checkout
# success/cancel URLs when the Origin header is missing. Leave unset on the
# spec build (the Vercel production URL is used); set to https://cascarellis.com
# the day the domain cuts over. (This file briefly listed it twice with
# different advice — this entry is the one.)
NEXT_PUBLIC_SITE_URL=

# ── Live tap list ────────────────────────────────────────────────────────────
# Base URL of the Cascarelli's Scooplist deployment (the studio's board app,
# second instance configured as a tap room). src/data/liveTaps.ts reads
# {url}/api/v1/case/homer. Unset or unreachable = the drinks page falls back
# to the transcribed snapshot in src/data/bar.ts and renders exactly as
# before the feed existed.
#
# That deployment needs, in ITS OWN Vercel env (see scooplist/.env.example):
#   SCOOPLIST_LOCATIONS=homer:Cascarelli's
#   SCOOPLIST_CATEGORIES=taps:On Tap
#   SCOOPLIST_ALLERGENS=-
#   SCOOPLIST_SIZES=taps=Pint:$PLACEHOLDER  <- real pour prices from the owner
SCOOPLIST_FEED_URL=
